s/when-life-changes-9","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#planned-sections","content":"Insurance questions, including when to consider life insurance."},"988":{"id":"/docs/chapters/when-life-changes-10","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#planned-sections","content":"Return to the four paths and update the plan."},"989":{"id":"/docs/chapters/when-life-changes-11","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#material-already-available","content":"Note 3 — questions, examples, and starting-path logic."},"990":{"id":"/docs/chapters/when-life-changes-12","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#material-already-available","content":"General plan and Plan decisions — the author's scope and direction."},"991":{"id":"/docs/chapters/when-life-changes-13","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#still-to-develop","content":"A change-of-circumstances checklist."},"992":{"id":"/docs/chapters/when-life-changes-14","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#still-to-develop","content":"Sources for reserves and insurance concepts without imposing one amount on every reader."},"993":{"id":"/docs/chapters/when-life-changes-15","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#still-to-develop","content":"A developed story from Note 3 after checking the timeline and figures."},"994":{"id":"/docs/chapters/when-life-changes-16","page_id":"/docs/chapters/when-life-changes","tags":[],"type":"text","url":"/docs/chapters/when-life-changes#still-to-develop","content":"Return to the chapter list."},"995":{"id":"/docs/chapters/when-you-get-paid","page_id":"/docs/chapters/when-you-get-paid","type":"page","content":"4. When you get paid","breadcrumbs":["Docs","Chapters"],"tags":[],"url":"/docs/chapters/when-you-get-paid"},"996":{"id":"/docs/chapters/when-you-get-paid-0","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid","content":"Plan the bills, saving, giving, and spending before the money arrives."},"997":{"id":"/docs/chapters/when-you-get-paid-1","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#look-at-the-bills-before-the-payday","content":"Look at the bills before the payday"},"998":{"id":"/docs/chapters/when-you-get-paid-2","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#know-which-money-youre-planning-with","content":"Know which money you're planning with"},"999":{"id":"/docs/chapters/when-you-get-paid-3","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Give saving a place in the plan"},"1000":{"id":"/docs/chapters/when-you-get-paid-4","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Where giving fits for me"},"1001":{"id":"/docs/chapters/when-you-get-paid-5","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"A month can work while a week doesn't"},"1002":{"id":"/docs/chapters/when-you-get-paid-6","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"What if there isn't enough?"},"1003":{"id":"/docs/chapters/when-you-get-paid-7","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#choose-tools-that-help-you-use-the-plan","content":"Choose tools that help you use the plan"},"1004":{"id":"/docs/chapters/when-you-get-paid-8","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#your-turn","content":"Your turn"},"1005":{"id":"/docs/chapters/when-you-get-paid-9","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"Where to go next"},"1006":{"id":"/docs/chapters/when-you-get-paid-10","page_id":"/docs/chapters/when-you-get-paid","type":"heading","tags":[],"url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"Draft sources and checks"},"1007":{"id":"/docs/chapters/when-you-get-paid-11","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid","content":"**First draft · Chapter 4.**"},"1008":{"id":"/docs/chapters/when-you-get-paid-12","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid","content":"Okay, so you've been paid. What happens next?"},"1009":{"id":"/docs/chapters/when-you-get-paid-13","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid","content":"My mom used to tell me that when I got paid, I should pay myself first. Put something away for myself. I think there's value in that, because you can spend the whole month working, get paid, pay everybody else, and reach the end with nothing saved. Then you do the same thing again the next month. I want us to make room for a saving habit where we can."},"1010":{"id":"/docs/chapters/when-you-get-paid-14","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid","content":"But there's a planning step before we decide how much to put away. We need to know what your money has to cover and when those payments are due. Otherwise, I could tell you to save a percentage that sounds great, and you'd be sitting there wondering how you're supposed to pay your rent."},"1011":{"id":"/docs/chapters/when-you-get-paid-15","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid","content":"That's the plan we're making here. It works for wages, business income, retirement payments, or support. If nothing is coming in right now, use the money you actually have and the shortfall section below. Don't wait for a future payday to see what needs attention."},"1012":{"id":"/docs/chapters/when-you-get-paid-16","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#look-at-the-bills-before-the-payday","content":"Before the next payday, sit down with your statements, bills, and the money picture from Chapter 1. Look at the whole coming month, including the bills that won't leave your account for a few weeks. Then look a little further ahead. If this month's pay has to cover next month's rent, that rent belongs in the plan you're making now."},"1013":{"id":"/docs/chapters/when-you-get-paid-17","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#look-at-the-bills-before-the-payday","content":"For each cost, write how much you need, when it's due, and when you need to send the payment for it to arrive on time. Start with the food, housing, utilities, transport, care, insurance, and required debt payments that apply to your life. Use the bill or agreement in front of you rather than assuming the amount is the same as last month, especially with something like a card minimum."},"1014":{"id":"/docs/chapters/when-you-get-paid-18","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#look-at-the-bills-before-the-payday","content":"Some costs won't show up on this month's bills, but you still need to get ready for them. If you're putting a little aside each payday for an annual bill, write down what that money is for. Otherwise, you could look at the account, think you have money left over, and spend what you were keeping for that bill."},"1015":{"id":"/docs/chapters/when-you-get-paid-19","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#look-at-the-bills-before-the-payday","content":"Then look at the subscriptions, dinners, trips, and other things you choose to spend on. You can care about those things; just be honest about what belongs where. Netflix doesn't become as urgent as rent because you enjoy watching it. You might need a phone or a car for work, but that still leaves a decision about which one you can afford."},"1016":{"id":"/docs/chapters/when-you-get-paid-20","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#look-at-the-bills-before-the-payday","content":"This is why I want you to look at the whole period. You don't want to pay for your gym and streaming subscriptions because the money is there today, then discover you can't cover rent because it comes out later. The order the payments leave your account shouldn't make that decision for you. The CFPB cash-flow tool gives a way to map the dates; it is a US consumer-education resource."},"1017":{"id":"/docs/chapters/when-you-get-paid-21","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#know-which-money-youre-planning-with","content":"Before we add anything up, decide which cash you can use for this plan. If you've protected some savings for another purpose, leave that money out. If a payment is on its way but hasn't cleared yet, mark the amount as committed. We're trying to see what you can still make decisions with, so check that the same balance hasn't ended up in two places."},"1018":{"id":"/docs/chapters/when-you-get-paid-22","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#know-which-money-youre-planning-with","content":"Put future receipts on a separate list with their expected dates, and distinguish a confirmed payment from one you're only hoping for. A customer saying they'll pay helps you plan, but you still need to check what actually arrives before spending it. We'll come back to that in Chapter 8, because spending a payment before it turns up is something I've fallen into myself."},"1019":{"id":"/docs/chapters/when-you-get-paid-23","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#know-which-money-youre-planning-with","content":"If the money comes from your own work, it may still have business costs and tax to cover. Separate those amounts before deciding what's available for your personal spending. In the US, independent contractors may need to make estimated tax payments, so check the current official guidance for your situation. The saving percentages we'll use below don't tell you how much tax to set aside. IRS gig-work tax guidance."},"1020":{"id":"/docs/chapters/when-you-get-paid-24","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#know-which-money-youre-planning-with","content":"Keep using whichever source labels fit: **Employer, Own work, Assets, and Support / retirement.** You can have more than one. Help that doesn't arrive as cash still matters, but keep it separate from money you can spend. And if you're drawing from savings to get through this period, show that withdrawal without counting it as a new ongoing income source."},"1021":{"id":"/docs/chapters/when-you-get-paid-25","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Once you've seen what the money needs to cover, you can decide what to put away and what you're saving for. What I care about here is getting into the habit of keeping some of what you earn, when your circumstances allow it. Saving doesn't have to wait until you feel like you're making a lot of money."},"1022":{"id":"/docs/chapters/when-you-get-paid-26","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"If you can afford to put away 25% to 30% of your pay, that's an amount I'd consider. But I mean if you can afford it. If that leaves you short for food or rent, the percentage doesn't work for you. You might start much smaller, and there will be periods when you can't put anything away. That's why we looked at the bills first."},"1023":{"id":"/docs/chapters/when-you-get-paid-27","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"You can start with a small amount that fits your circumstances; the CFPB's emergency-fund guide takes that approach too. If you set up an automatic saving transfer, keep an eye on the account it comes from. You don't want the transfer to go through when there isn't enough there and cause an overdraft. CFPB emergency-saving guide."},"1024":{"id":"/docs/chapters/when-you-get-paid-28","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Let's use a fictional monthly plan in generic dollars. You bring home $5,000, and there are no further business costs or taxes to take out. All your required costs and debt payments come to $2,500, including money you need to reserve for later known bills. We'll leave giving out of this first version and work through it separately below."},"1025":{"id":"/docs/chapters/when-you-get-paid-29","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Monthly plan"},"1026":{"id":"/docs/chapters/when-you-get-paid-30","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Amount"},"1027":{"id":"/docs/chapters/when-you-get-paid-31","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Take-home income"},"1028":{"id":"/docs/chapters/when-you-get-paid-32","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"$5,000"},"1029":{"id":"/docs/chapters/when-you-get-paid-33","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Required costs and payments"},"1030":{"id":"/docs/chapters/when-you-get-paid-34","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"−$2,500"},"1031":{"id":"/docs/chapters/when-you-get-paid-35","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Saving: 25% of the full $5,000"},"1032":{"id":"/docs/chapters/when-you-get-paid-36","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"−$1,250"},"1033":{"id":"/docs/chapters/when-you-get-paid-37","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Left to allocate"},"1034":{"id":"/docs/chapters/when-you-get-paid-38","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"$1,250"},"1035":{"id":"/docs/chapters/when-you-get-paid-39","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Now you can see what the last $1,250 is available for. You might use some for dinners or other things you enjoy, put more toward debt, or keep more aside. Make that choice while you're looking at the whole plan, so the money doesn't disappear through purchases you never thought about together. You don't have to use it all up."},"1036":{"id":"/docs/chapters/when-you-get-paid-40","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Now suppose the fictional numbers are tighter: you have $2,000 after tax, and required costs take $1,600 of it. With $400 left, you could choose to save 25% of **that $400 remainder**. That puts $100 into savings and leaves $300 for you to allocate. Measured against the original $2,000, you're saving 5%, even though you used 25% when you worked out what to keep from the remainder."},"1037":{"id":"/docs/chapters/when-you-get-paid-41","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"Notice what changed: in the first example, we saved a percentage of the whole take-home amount. In the second, we saved a percentage of what remained after required costs. Saying “I save 25%” doesn't tell us which one you mean. Write the dollar amount beside the percentage so you can see what the decision leaves you with."},"1038":{"id":"/docs/chapters/when-you-get-paid-42","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#give-saving-a-place-in-the-plan","content":"If you have costly debt as well as room to save, compare those uses of the money in Chapter 5. The example here doesn't settle the right balance for everyone."},"1039":{"id":"/docs/chapters/when-you-get-paid-43","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"I'm a Christian, and I believe in paying my tithes. That's part of how I handle my money, and it's part of what I'm sharing with you here. I'm not going to spend this section arguing back and forth about that belief. What I can explain is the way I've made room for it in my own planning."},"1040":{"id":"/docs/chapters/when-you-get-paid-44","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"For a long time, I've found it easier to treat that 10% as already set aside and plan with the rest. If I'm planning to tithe, I don't want to finish allocating all my money and then remember that I still have my tithes to pay. I've also tithed on income before tax. The example here uses take-home income, so you can see exactly what we're calculating."},"1041":{"id":"/docs/chapters/when-you-get-paid-45","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"With $5,000 in take-home income, that 10% is $500, leaving $4,500 for the rest of the plan. You've still earned $5,000; you've decided that $500 of it is going toward giving. Thinking about the remainder from the start is what helps me account for it."},"1042":{"id":"/docs/chapters/when-you-get-paid-46","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Here's one way the rest could work. This is a separate illustrative version, with saving chosen as 25% of the **$4,500 after giving**."},"1043":{"id":"/docs/chapters/when-you-get-paid-47","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Monthly plan with giving"},"1044":{"id":"/docs/chapters/when-you-get-paid-48","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Amount"},"1045":{"id":"/docs/chapters/when-you-get-paid-49","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Take-home income"},"1046":{"id":"/docs/chapters/when-you-get-paid-50","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"$5,000"},"1047":{"id":"/docs/chapters/when-you-get-paid-51","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Giving: 10% of take-home income"},"1048":{"id":"/docs/chapters/when-you-get-paid-52","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"−$500"},"1049":{"id":"/docs/chapters/when-you-get-paid-53","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Required costs and payments"},"1050":{"id":"/docs/chapters/when-you-get-paid-54","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"−$2,500"},"1051":{"id":"/docs/chapters/when-you-get-paid-55","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Saving: 25% of $4,500"},"1052":{"id":"/docs/chapters/when-you-get-paid-56","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"−$1,125"},"1053":{"id":"/docs/chapters/when-you-get-paid-57","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Left to allocate"},"1054":{"id":"/docs/chapters/when-you-get-paid-58","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"$875"},"1055":{"id":"/docs/chapters/when-you-get-paid-59","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"Because we're now saving a percentage of the amount after giving, the saving amount changes too. We have to work through the whole plan again; we can't add a giving line and assume the same remainder will still be there."},"1056":{"id":"/docs/chapters/when-you-get-paid-60","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-giving-fits-for-me","content":"If giving is part of your life, put it on the page alongside the bills so you can see what the whole plan asks of your money. This example has room for all of those choices. Yours may not, and if there's a gap, we need to acknowledge it and work through the shortfall section below. Choosing a giving or saving percentage won't make the missing money appear."},"1057":{"id":"/docs/chapters/when-you-get-paid-61","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"Let's go back to the first $5,000 plan, without giving. Suppose it arrives in two payments of $2,500, on the 1st and 15th. There is no opening balance assigned to this plan. Assume $2,000 of the required costs fall before the second payment, and $500 after it."},"1058":{"id":"/docs/chapters/when-you-get-paid-62","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"If you divide the monthly saving amount in half and take $625 out of that first payment, you'll have $1,875 left for $2,000 of bills. You're $125 short before the next payday, even though the monthly plan looked fine. This is why knowing the total isn't enough: we need to know when the money arrives and when it has to leave."},"1059":{"id":"/docs/chapters/when-you-get-paid-63","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"One possible schedule is:"},"1060":{"id":"/docs/chapters/when-you-get-paid-64","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"Period"},"1061":{"id":"/docs/chapters/when-you-get-paid-65","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"Money available"},"1062":{"id":"/docs/chapters/when-you-get-paid-66","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"What this part covers"},"1063":{"id":"/docs/chapters/when-you-get-paid-67","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"Carried forward"},"1064":{"id":"/docs/chapters/when-you-get-paid-68","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"1st–14th"},"1065":{"id":"/docs/chapters/when-you-get-paid-69","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"$2,500 received"},"1066":{"id":"/docs/chapters/when-you-get-paid-70","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"$2,000 required costs; hold the rest"},"1067":{"id":"/docs/chapters/when-you-get-paid-71","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"$500"},"1068":{"id":"/docs/chapters/when-you-get-paid-72","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"15th–month end"},"1069":{"id":"/docs/chapters/when-you-get-paid-73","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"$500 carried + $2,500 received = $3,000"},"1070":{"id":"/docs/chapters/when-you-get-paid-74","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"$500 required costs; $1,250 saving; $1,250 left to allocate"},"1071":{"id":"/docs/chapters/when-you-get-paid-75","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"$0 unassigned after those allocations"},"1072":{"id":"/docs/chapters/when-you-get-paid-76","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"When the second payment arrives, the table gives every dollar somewhere to go. That doesn't mean you send it all out on the 15th. Keep each amount until you need it, and look ahead to what comes due before you're paid again. This example assumes the next payment arrives before the next period's costs; if your dates work differently, you'll need to reserve money for those costs now."},"1073":{"id":"/docs/chapters/when-you-get-paid-77","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"Your own calendar needs the actual date of each bill. Start with the opening balance, add a receipt when it comes in, subtract a payment when it goes out, and carry what's left to the next date. You're following the money through the month. If that running amount goes below zero, you've found a gap that the monthly total may have hidden. The CFPB cash-flow worksheet uses this running-balance approach."},"1074":{"id":"/docs/chapters/when-you-get-paid-78","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"On workbook page 11, you can also subtract money when you reserve it for a bill. If you use that option, the running amount tells you what's still available for this plan, which can differ from the balance your bank shows. When the reserved bill is paid, don't subtract it again. You've already accounted for that money."},"1075":{"id":"/docs/chapters/when-you-get-paid-79","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#a-month-can-work-while-a-week-doesnt","content":"If the same dates keep clashing, contact the provider and ask whether a different due date or payment arrangement is available. If they offer a change, find out the new amount, any cost, when it starts, and what you still owe in the meantime. Keep planning around the existing date until the change is confirmed. Canceling and restarting a service doesn't generally resolve a bill you've already incurred. CFPB guidance on adjusting cash flow."},"1076":{"id":"/docs/chapters/when-you-get-paid-80","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"Sometimes you do all of this and there still isn't enough to pay every bill. I'm not going to sit here and tell you that you should always be able to make it work, because I've been in that situation myself. And if there isn't room to save the percentage we just talked about, that's okay. We need to deal with the money you have."},"1077":{"id":"/docs/chapters/when-you-get-paid-81","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"When I'm in that position, I make a priority list. I look at what absolutely needs attention and what happens if I can't pay it. Your list might be different from mine, so write the consequences beside the amounts and dates. That gives you a reason for the order you choose, beyond whichever bill happens to arrive first."},"1078":{"id":"/docs/chapters/when-you-get-paid-82","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"Think about your basic needs and what protects your housing, health, and ability to earn. Include essential insurance and court-ordered obligations as you look at what could happen if a payment is missed. The dates and consequences in your own situation will help you decide what comes first. For bills you can't cover, contact the providers to ask what help or arrangements are available. The CFPB prioritizing-bills tool works through those consequences rather than giving everybody the same fixed order."},"1079":{"id":"/docs/chapters/when-you-get-paid-83","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"Here's a fictional shortfall for one pay period. You have $1,200 available, after any amounts already committed elsewhere. Needs and required payments total $1,500. There are no optional purchases, giving, or new saving in these figures. You're $300 short."},"1080":{"id":"/docs/chapters/when-you-get-paid-84","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"There isn't a saving percentage that makes those numbers fit. Use the shortfall sheet to see which bills are due and what is at risk, then check available support and contact the providers you can't pay in full. Record what they confirm, including any change to the amount or date. Until confirmed help or an agreed change closes it, that $300 gap is still there. Expected income needs to arrive before you can use it."},"1081":{"id":"/docs/chapters/when-you-get-paid-85","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#what-if-there-isnt-enough","content":"Keep any missed payment on your debt record, even if you had a more urgent bill to pay first. You'll still need to deal with what remains unpaid. If your housing or utilities are at immediate risk, or you have a court deadline, seek appropriate local help promptly so you can work with the rules and options where you live."},"1082":{"id":"/docs/chapters/when-you-get-paid-86","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#choose-tools-that-help-you-use-the-plan","content":"Paper, a spreadsheet, or an app can all give you somewhere to keep this plan. Choose something you can use to see the amounts and dates together, because that's the information you need when you're deciding what to pay."},"1083":{"id":"/docs/chapters/when-you-get-paid-87","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#choose-tools-that-help-you-use-the-plan","content":"Suppose an app shows you $500, but you need $450 of it for a bill. You still need to be able to see that commitment when deciding what to spend. Check whether the app includes upcoming payments and whether its transactions are up to date. It can help you keep the records together, but you still have to decide what that money will cover."},"1084":{"id":"/docs/chapters/when-you-get-paid-88","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#choose-tools-that-help-you-use-the-plan","content":"The account you use needs to work with that plan too. Look at how you can access your money and make payments, what support is available, and what fees you could pay. Read the conditions for avoiding monthly charges instead of assuming the account will always be free. As the CFPB explains, some US accounts require things such as a minimum balance or direct deposit to avoid a fee. CFPB account-fee guidance."},"1085":{"id":"/docs/chapters/when-you-get-paid-89","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#choose-tools-that-help-you-use-the-plan","content":"Also check who actually holds the money and what protection applies. In the US, some nonbank services place money at banks, where it may qualify for what's called pass-through FDIC deposit insurance. That coverage depends on requirements being met, so the app's appearance alone doesn't tell you whether your money qualifies. Read the disclosures. FDIC explanation. Other countries have different systems."},"1086":{"id":"/docs/chapters/when-you-get-paid-90","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"Now let's do this with your money. Use workbook **10. My next payment plan**, **11. My bill calendar**, and **12. When money falls short**. If you're using plain paper, give three sheets those same headings and work through the steps below."},"1087":{"id":"/docs/chapters/when-you-get-paid-91","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"**Choose the period you're planning for.** Put the start and end dates at the top, along with the currency and whose money you're including. Write the cash available at the start, showing what you've left out because it's reserved elsewhere. List future receipts separately with their dates and how certain they are. Account for any business costs or tax still to cover once, so you can see what you're starting with and what still has to arrive."},"1088":{"id":"/docs/chapters/when-you-get-paid-92","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"**Give that money somewhere to go.** Bring your required costs, debt payments, and amounts reserved for later bills onto the page. Then include any giving, saving, and other spending you've chosen. If you use a percentage, write what you're taking that percentage of. An unknown amount means the plan is provisional; keep it visible so you know what to check before relying on the remainder."},"1089":{"id":"/docs/chapters/when-you-get-paid-93","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"**Follow it through the calendar.** Put each receipt and payment on its date, including automatic payments already set up. Allow enough time for a payment to arrive where it's due. Add money in, subtract money out, and carry the balance to the next date, marking whether incoming money has arrived or is still forecast. Now you can see whether the plan works all the way through the period."},"1090":{"id":"/docs/chapters/when-you-get-paid-94","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"**Work through any gap.** If the balance goes below zero or a need remains uncovered, take it to page 12. Write what could happen, whom you'll contact, what changes they've confirmed, and what remains unpaid. Go back through your choices before treating any remainder as money you can spend."},"1091":{"id":"/docs/chapters/when-you-get-paid-95","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"**Check the plan when you're paid.** Compare what actually arrived with what you expected, and confirm the bills before making payments or transfers. Make only those the available funds can support, then record what you did. Review the plan before the next payment comes in, or sooner if something changes."},"1092":{"id":"/docs/chapters/when-you-get-paid-96","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#your-turn","content":"If you move money between two accounts included in your calendar, label it as a transfer. Count the amount leaving one and entering the other once each; your combined balance hasn't changed. You haven't earned new income or paid a second expense. Money you've allocated to savings still belongs to you, but you've already chosen a purpose for it, so keep it out of the unassigned spending amount."},"1093":{"id":"/docs/chapters/when-you-get-paid-97","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"Your path"},"1094":{"id":"/docs/chapters/when-you-get-paid-98","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"Next chapter"},"1095":{"id":"/docs/chapters/when-you-get-paid-99","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"I-D · Income, with debt"},"1096":{"id":"/docs/chapters/when-you-get-paid-100","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"5. Make a plan for debt, using the payments and any shortfalls you've recorded."},"1097":{"id":"/docs/chapters/when-you-get-paid-101","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"I-ND · Income, no debt"},"1098":{"id":"/docs/chapters/when-you-get-paid-102","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"2. The life you want, to give the available money a purpose or review the target you already made."},"1099":{"id":"/docs/chapters/when-you-get-paid-103","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"N-D · No income, with debt"},"1100":{"id":"/docs/chapters/when-you-get-paid-104","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"3. Find and grow your income, while acting on urgent shortfalls and provider contacts now."},"1101":{"id":"/docs/chapters/when-you-get-paid-105","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"N-ND · No income, no debt"},"1102":{"id":"/docs/chapters/when-you-get-paid-106","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#where-to-go-next","content":"3. Find and grow your income, using your current resources and next income or support step."},"1103":{"id":"/docs/chapters/when-you-get-paid-107","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"This draft develops Note 9, with the planning questions from Note 3. All worked numbers are illustrative generic-dollar assumptions. The source's changing percentages and small-surplus figures remain preserved in the raw transcript. Research notes record the checks and limits. The spoken adaptation uses the same examples and qualifications."},"1104":{"id":"/docs/chapters/when-you-get-paid-108","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"*Source: Note 9, 00:00–05:06, including the author's correction to plan bills before choosing a saving amount.*"},"1105":{"id":"/docs/chapters/when-you-get-paid-109","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"*Source: Note 9, 03:02–06:04 and 17:00–18:42. The calendar method is supported by the CFPB cash-flow tool, a US consumer-education resource.*"},"1106":{"id":"/docs/chapters/when-you-get-paid-110","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"*Source: Note 9, 05:06–09:10. The smaller example settles one set of assumptions from figures that change in the recording.*"},"1107":{"id":"/docs/chapters/when-you-get-paid-111","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"*Source: Note 9, 10:03–13:00. The belief and practice are the author's. The completed calculation is illustrative; it makes no promise of a financial return for giving.*"},"1108":{"id":"/docs/chapters/when-you-get-paid-112","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"*Source: Note 9, 14:01–18:42. The shortfall arithmetic is a new fictional illustration. The unclear passage around 16:29 is not quoted.*"},"1109":{"id":"/docs/chapters/when-you-get-paid-113","page_id":"/docs/chapters/when-you-get-paid","tags":[],"type":"text","url":"/docs/chapters/when-you-get-paid#draft-sources-and-checks","content":"*Source direction: Note 3 and General plan. This section develops a practical tool check; it does not claim budgeting apps generally fail or recommend a specific product.*"},"1110":{"id":"/docs","page_id":"/docs","type":"page","content":"Untitled Book","breadcrumbs":["Docs"],"tags":[],"url":"/docs"},"1111":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"A practical money book and companion workbook built from your voice notes."},"1112":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#add-another-recording","content":"Add another recording"},"1113":{"id":"/docs-2","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"The book starts with where the reader is and the life they want. Its pages give them a place to work through the next money decision."},"1114":{"id":"/docs-3","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Raw thoughts\" href=\"/docs/raw-thoughts\" description=\"The recordings and written plan behind the book.\" />"},"1115":{"id":"/docs-4","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Book plan\" href=\"/docs/outline\" description=\"Twelve chapters and the sections inside them.\" />"},"1116":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Reader paths\" href=\"/docs/reader-paths\" description=\"Four situations based on income and debt.\" />"},"1117":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Chapters\" href=\"/docs/chapters\" description=\"Chapters 1–8 drafted. Chapters 9–12 ready to develop.\" />"},"1118":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Spoken scripts\" href=\"/docs/scripts\" description=\"Spoken adaptations of Chapters 2–8.\" />"},"1119":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Companion workbook\" href=\"/docs/workbook\" description=\"Pages 1–18 for Chapters 1–8. Plain paper works too.\" />"},"1120":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Print preview\" href=\"/docs/print-preview\" description=\"See the book and workbook as actual-size pages.\" />"},"1121":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Topic notes\" href=\"/docs/topics\" description=\"Supporting ideas, research leads, and early exercises.\" />"},"1122":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Writing guide\" href=\"/docs/writing-style\" description=\"Keep the author's voice clear and direct.\" />"},"1123":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Read Chapter 1: Start where you are for the income map, debt map, four paths, and first worksheet."},"1124":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#add-another-recording","content":"Attach it in the Codex chat for this project. The assistant will add the next numbered raw note and place its ideas in the book. The workflow explains how the transcript, draft prose, and facts to check fit together."},"1125":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#add-another-recording","content":"The book title is still open. The brief records the promise being developed, and Research notes tracks the evidence still needed."},"1126":{"id":"/docs/outline","page_id":"/docs/outline","type":"page","content":"Book plan","breadcrumbs":["Docs"],"tags":[],"url":"/docs/outline"},"1127":{"id":"/docs/outline-0","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline","content":"Twelve chapters built around the reader's situation and the life they want."},"1128":{"id":"/docs/outline-1","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#what-the-book-does","content":"What the book does"},"1129":{"id":"/docs/outline-2","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#the-companion-workbook","content":"The companion workbook"},"1130":{"id":"/docs/outline-3","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#the-chapter-plan","content":"The chapter plan"},"1131":{"id":"/docs/outline-4","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#find-your-place","content":"Find your place"},"1132":{"id":"/docs/outline-5","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#build-your-money-plan","content":"Build your money plan"},"1133":{"id":"/docs/outline-6","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#use-credit-and-spend","content":"Use credit and spend"},"1134":{"id":"/docs/outline-7","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#protect-and-grow","content":"Protect and grow"},"1135":{"id":"/docs/outline-8","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#drafted-chapters","content":"Drafted chapters"},"1136":{"id":"/docs/outline-9","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#new-recording-material","content":"New recording material"},"1137":{"id":"/docs/outline-10","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#reader-paths-and-money-maps","content":"Reader paths and money maps"},"1138":{"id":"/docs/outline-11","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#where-the-smaller-questions-go","content":"Where the smaller questions go"},"1139":{"id":"/docs/outline-12","page_id":"/docs/outline","type":"heading","tags":[],"url":"/docs/outline#writing-and-example-rules","content":"Writing and example rules"},"1140":{"id":"/docs/outline-13","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#what-the-book-does","content":"Help the reader describe the life they want and calculate what it takes. Then help them make the next money decision from where they are. Growing income and reducing debt support that goal. This follows the correction in Note 3."},"1141":{"id":"/docs/outline-14","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#what-the-book-does","content":"The book is used by situation. Chapter numbers help readers find and return to a section; they do not require reading every page in order."},"1142":{"id":"/docs/outline-15","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#the-companion-workbook","content":"Keep explanations, stories, examples, and exercise instructions in the book. Put the blank tables and answer spaces in the optional companion workbook. Reference each workbook page by number and name. Readers without it must be able to follow the same steps on plain paper."},"1143":{"id":"/docs/outline-16","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#the-companion-workbook","content":"Chapter 1 uses workbook pages 1–4: What I have now, What comes in, What I owe, and My money today. Chapter 2 uses pages 5–7: My chosen life, What that life costs, and My target and next step. Chapter 3 uses pages 8–9: My income options and My next income step. Chapter 4 uses pages 10–12; Chapter 5 uses 13–14; Chapter 6 uses 15–16; Chapter 7 uses 17; Chapter 8 uses 18. Add later workbook pages as their chapter exercises are drafted. These are working page numbers; confirm the final references during print layout."},"1144":{"id":"/docs/outline-17","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#the-chapter-plan","content":"Keep Before we start and How to use this book as short opening sections. The numbered chapters begin with a map of the reader's money."},"1145":{"id":"/docs/outline-18","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#find-your-place","content":"**1. Start where you are** — Put what you have, what comes in, and what you owe on paper. Choose your starting path."},"1146":{"id":"/docs/outline-19","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#find-your-place","content":"**2. The life you want** — Describe the life you want and put a cost on it."},"1147":{"id":"/docs/outline-20","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#build-your-money-plan","content":"**3. Find and grow your income** — Choose the next income step that fits your situation."},"1148":{"id":"/docs/outline-21","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#build-your-money-plan","content":"**4. When you get paid** — Make a plan for the next money that comes in."},"1149":{"id":"/docs/outline-22","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#build-your-money-plan","content":"**5. Make a plan for debt** — Understand what you owe and build a repayment plan."},"1150":{"id":"/docs/outline-23","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#use-credit-and-spend","content":"**6. Credit cards 101** — Understand the card, the bill, and the payment decision."},"1151":{"id":"/docs/outline-24","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#use-credit-and-spend","content":"**7. Credit scores 101** — Know what a credit score can tell you and when it matters."},"1152":{"id":"/docs/outline-25","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#use-credit-and-spend","content":"**8. Before you buy** — Decide whether an expensive purchase fits your plan."},"1153":{"id":"/docs/outline-26","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#protect-and-grow","content":"**9. When life changes** — Adjust the plan when income, costs, or family needs change."},"1154":{"id":"/docs/outline-27","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#protect-and-grow","content":"**10. The promise of fast money** — Examine a promise of quick wealth before acting on it."},"1155":{"id":"/docs/outline-28","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#protect-and-grow","content":"**11. Before you invest** — Work out what the money is for and what risk you can take."},"1156":{"id":"/docs/outline-29","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#protect-and-grow","content":"**12. Ways to invest** — Understand the main investment choices and compare them."},"1157":{"id":"/docs/outline-30","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#drafted-chapters","content":"Chapter 1: Start where you are is drafted. It explains why seeing the numbers makes planning possible. It defines income and debt, shows the two money maps, explains mixed sources, and gives four starting-path examples. The exercise has readers check accounts and records, write what they have and owe, and put those totals beside income on one sheet. The book keeps the filled-in example and paper instructions. Companion workbook pages 1–4 hold the blank worksheets."},"1158":{"id":"/docs/outline-31","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#drafted-chapters","content":"Chapter 2: The life you want now has a first draft, a rebuilt fictional Michelle example, workbook pages 5–7, and a spoken adaptation. Chapter 3: Find and grow your income has a first draft, workbook pages 8–9, and a spoken adaptation. Chapters 4–8 now also have first drafts, spoken scripts, and workbook pages 10–18. Chapters 9–12 remain placeholders with section plans and material to draw from. The title and final wording of the book's promise remain open."},"1159":{"id":"/docs/outline-32","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Notes 4–9 add source material for Chapters 2–8. The October 1 incorporation plan maps passages, proposed script outlines, exercises, drafting order, and checks still needed. Chapters 2–8 are developed as first drafts from this batch. The recording-based drafting sequence is complete; the drafts still need author review and final print layout."},"1160":{"id":"/docs/outline-33","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"New material"},"1161":{"id":"/docs/outline-34","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Planned home"},"1162":{"id":"/docs/outline-35","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Michelle's desired life, family time, work, and costs"},"1163":{"id":"/docs/outline-36","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 2 worked example; Chapter 3 income options"},"1164":{"id":"/docs/outline-37","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Adviser story, Ferrari/Jeep analogy, and income targets broken into actions"},"1165":{"id":"/docs/outline-38","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 3, with a brief Chapter 2 preview"},"1166":{"id":"/docs/outline-39","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Temporary income and job applications, with student and stay-at-home-parent qualifications"},"1167":{"id":"/docs/outline-40","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 3 no-income section"},"1168":{"id":"/docs/outline-41","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Saving, tithing, payment dates, and bills when money is short"},"1169":{"id":"/docs/outline-42","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 4 payday plan; links to Chapters 5 and 9"},"1170":{"id":"/docs/outline-43","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Overdrafts, lines of credit, charge cards, card statements, and rewards"},"1171":{"id":"/docs/outline-44","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 5 borrowing comparison and Chapter 6 card explanation"},"1172":{"id":"/docs/outline-45","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Reports, score models, applications, and utilization"},"1173":{"id":"/docs/outline-46","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 7"},"1174":{"id":"/docs/outline-47","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"“Afford it twice,” expected income, BNPL, and car purchases"},"1175":{"id":"/docs/outline-48","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Chapter 8"},"1176":{"id":"/docs/outline-49","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Online exercises, QR links, reminders, and reader questions"},"1177":{"id":"/docs/outline-50","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Open companion/support ideas in the writing plan"},"1178":{"id":"/docs/outline-51","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#new-recording-material","content":"Keep the existing chapter order and companion-workbook approach while these ideas are developed. Raw numerical examples and product claims still need the checks in Research notes."},"1179":{"id":"/docs/outline-52","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#reader-paths-and-money-maps","content":"The four paths remain **I-D**, **I-ND**, **N-D**, and **N-ND**: income or no income, each with or without debt. Debt means money owed. The income side includes current income or support, not just a job."},"1180":{"id":"/docs/outline-53","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#reader-paths-and-money-maps","content":"The income map has four source groups: employer pay; own work or business; assets; and support or retirement payments. Hourly and salary sit under employer pay. A reader can have several sources."},"1181":{"id":"/docs/outline-54","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#reader-paths-and-money-maps","content":"The debt map groups amounts by how they arose: borrowing or credit; unpaid bills; and taxes, fines, and court-ordered amounts. Cost, purpose, creditor, and payment terms add detail. “Good” and “bad” debt are judgments to examine, not extra starting paths."},"1182":{"id":"/docs/outline-55","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#reader-paths-and-money-maps","content":"These are teaching maps for the workbook. The research record documents their evidence and boundaries. Reader paths records how to tag later chapters."},"1183":{"id":"/docs/outline-56","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Question or topic"},"1184":{"id":"/docs/outline-57","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Chapter / section"},"1185":{"id":"/docs/outline-58","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Mindset, different priorities, and the dream-day exercise"},"1186":{"id":"/docs/outline-59","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"2 · The life you want"},"1187":{"id":"/docs/outline-60","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Hourly work, salary, business, mixed sources, and salary conversations"},"1188":{"id":"/docs/outline-61","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"3 · Find and grow your income"},"1189":{"id":"/docs/outline-62","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Saving from a pay cheque, giving to church, budgets, budgeting apps, banks, and fintech services"},"1190":{"id":"/docs/outline-63","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"4 · When you get paid"},"1191":{"id":"/docs/outline-64","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Good/bad debt, loans vs lines of credit, tax bills, collections, and debt collectors"},"1192":{"id":"/docs/outline-65","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"5 · Make a plan for debt"},"1193":{"id":"/docs/outline-66","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Borrowing from or lending to friends and family"},"1194":{"id":"/docs/outline-67","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"5 · Make a plan for debt"},"1195":{"id":"/docs/outline-68","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Minimum payments, card interest, and debit vs credit"},"1196":{"id":"/docs/outline-69","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"6 · Credit cards 101"},"1197":{"id":"/docs/outline-70","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Credit-score history and when scores matter"},"1198":{"id":"/docs/outline-71","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"7 · Credit scores 101"},"1199":{"id":"/docs/outline-72","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Expensive purchases and BNPL"},"1200":{"id":"/docs/outline-73","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"8 · Before you buy"},"1201":{"id":"/docs/outline-74","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Job loss, moving, marriage, large unplanned costs, and life insurance"},"1202":{"id":"/docs/outline-75","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"9 · When life changes; income recovery links to 3"},"1203":{"id":"/docs/outline-76","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Get-rich-quick schemes"},"1204":{"id":"/docs/outline-77","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"10 · The promise of fast money"},"1205":{"id":"/docs/outline-78","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Investment timing, goals, risk, fees, and access to money"},"1206":{"id":"/docs/outline-79","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"11 · Before you invest"},"1207":{"id":"/docs/outline-80","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Stocks, funds, bonds, Treasuries, real estate, crypto, businesses, private equity, and hedge funds"},"1208":{"id":"/docs/outline-81","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"12 · Ways to invest"},"1209":{"id":"/docs/outline-82","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#where-the-smaller-questions-go","content":"Keep new questions in this map even before their prose is drafted. Add a section within its chapter first. Give it a separate chapter only if its scope calls for one."},"1210":{"id":"/docs/outline-83","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#writing-and-example-rules","content":"Use generic **$** amounts in worked examples. Keep real source figures intact; any published use needs the correct context."},"1211":{"id":"/docs/outline-84","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#writing-and-example-rules","content":"Debt includes all money the reader owes. Do not omit an amount because someone calls it good debt."},"1212":{"id":"/docs/outline-85","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#writing-and-example-rules","content":"Explain each broad group with concrete examples. Keep pay method separate from income source."},"1213":{"id":"/docs/outline-86","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#writing-and-example-rules","content":"Preserve the author's voice, stories, and respect for different goals."},"1214":{"id":"/docs/outline-87","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#writing-and-example-rules","content":"Each chapter needs an explanation, an example, steps, and an exercise. Research factual claims before treating a draft as finished."},"1215":{"id":"/docs/outline-88","page_id":"/docs/outline","tags":[],"type":"text","url":"/docs/outline#writing-and-example-rules","content":"Sources: Notes 1–3, General plan, and Plan decisions."},"1216":{"id":"/docs/print-preview","page_id":"/docs/print-preview","type":"page","content":"Print preview","breadcrumbs":["Docs"],"tags":[],"url":"/docs/print-preview"},"1217":{"id":"/docs/print-preview-0","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview","content":"See Chapter 1 and its companion workbook laid out as real book pages."},"1218":{"id":"/docs/print-preview-1","page_id":"/docs/print-preview","type":"heading","tags":[],"url":"/docs/print-preview#the-two-sizes","content":"The two sizes"},"1219":{"id":"/docs/print-preview-2","page_id":"/docs/print-preview","type":"heading","tags":[],"url":"/docs/print-preview#chapter-1--the-book","content":"Chapter 1 · the book"},"1220":{"id":"/docs/print-preview-3","page_id":"/docs/print-preview","type":"heading","tags":[],"url":"/docs/print-preview#the-companion-workbook","content":"The companion workbook"},"1221":{"id":"/docs/print-preview-4","page_id":"/docs/print-preview","type":"heading","tags":[],"url":"/docs/print-preview#try-it-on-paper","content":"Try it on paper"},"1222":{"id":"/docs/print-preview-5","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview","content":"This is a first interior design proof using an earlier Chapter 1 draft and its four workbook pages. The online chapter has since received a voice revision; the PDFs and preview images have not yet been regenerated. The book title is still open. Chapters 2–8 and workbook pages 5–18 are available as draft text; they are not included in these PDFs."},"1223":{"id":"/docs/print-preview-6","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#the-two-sizes","content":"The **book is 6 × 9 inches**. The **companion workbook is 8½ × 11 inches**, with more room to write. The image below shows them at the same scale."},"1224":{"id":"/docs/print-preview-7","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#the-two-sizes","content":"Six by nine inches is a common US paperback size. There isn't one required size for a book. This is a starting choice we can change after reviewing the pages. KDP trim-size guide."},"1225":{"id":"/docs/print-preview-8","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#chapter-1--the-book","content":"The PDF contains the full chapter, including its examples, tables, exercise instructions, and source notes. It uses a serif reading font, clear headings, page numbers, and extra space at the binding edge."},"1226":{"id":"/docs/print-preview-9","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#chapter-1--the-book","content":"**Open the Chapter 1 PDF**"},"1227":{"id":"/docs/print-preview-10","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#the-companion-workbook","content":"The PDF has four physical pages, matching the references in Chapter 1. Each has blank tables or ruled answer spaces. Dates, interest, fees, and other unknown details remain optional where the chapter says they can wait."},"1228":{"id":"/docs/print-preview-11","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#the-companion-workbook","content":"**Open the four-page workbook PDF**"},"1229":{"id":"/docs/print-preview-12","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#try-it-on-paper","content":"Print the PDFs at **100% / actual size**. The book PDF is already 6 × 9 inches; on a larger sheet, trim it to that size to judge how it feels. The workbook uses letter-size paper."},"1230":{"id":"/docs/print-preview-13","page_id":"/docs/print-preview","tags":[],"type":"text","url":"/docs/print-preview#try-it-on-paper","content":"These are layout proofs. Page references, margins, and pagination will be checked again when the whole book and the printer are chosen."},"1231":{"id":"/docs/print-preview-14","page_id":"/docs/print-preview